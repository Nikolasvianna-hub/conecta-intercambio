        <mxCell id="note" value="Reels/posts de estudantes só aparecem após moderação (RN06).&#xa;Conversas: só conexões ou pedidos aceitos (RN11); moderação acessa&#xa;apenas trechos denunciados (RN12). UC19/UC20 ficam na aba Menu." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;fontSize=11;fillColor=#fffbeb;strokeColor=#d97706;" vertex="1" parent="1"><mxGeometry x="262" y="752" width="390" height="62" as="geometry"/></mxCell>
